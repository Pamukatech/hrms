# Local configuration for this machine.
# Copy of .env.example — edit the values below, then restart the server.

APP_NAME=Payroll System

# The public URL of the site.  Email links (activation, password reset) are
# built from this, so it must be reachable by whoever receives the email.
# Local:      http://127.0.0.1:8000
# Production: https://payroll.yourcompany.com
APP_BASE_URL=http://127.0.0.1:8000

# Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# APP_SECRET_KEY=

# ---------------------------------------------------------------------------
# Platform administrator
# ---------------------------------------------------------------------------
# Comma-separated list of the ONLY email addresses that may open the admin
# panel (/admin).  Any other account — even one whose role was changed to
# platform_admin by mistake — is refused, and the "Admin panel" link is
# hidden from its sidebar.
# Leave it empty to allow every account holding the platform_admin role.
PLATFORM_ADMIN_EMAILS=pamukatech@gmail.com

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave DATABASE_URL empty to use the bundled SQLite file (hrms.db) — perfect
# for local development and for a single-user install.
#
# Uncomment the line below to use the MySQL/MariaDB server that ships with
# XAMPP instead (see the README for the one-time setup):
#
DATABASE_URL=mysql+pymysql://payroll:payroll@127.0.0.1:3306/payroll?charset=utf8mb4
# DATABASE_URL=

# ---------------------------------------------------------------------------
# Mail delivery
# ---------------------------------------------------------------------------
# "console" (default) writes every message to the outbox/ folder instead of
# sending it — nothing ever reaches a real inbox.  Switch to "smtp" and fill
# in the SMTP details below to actually deliver mail.
MAIL_DRIVER=console
# MAIL_DRIVER=smtp

# --- Example: Gmail (needs an App Password, not your account password) ---
#   1. Enable 2-Step Verification on the Google account.
#   2. Go to https://myaccount.google.com/apppasswords and create one.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-16-character-app-password
# SMTP_TLS=true
# SMTP_SSL=false

# --- Example: Brevo / SendGrid / Mailgun / your host ---
# SMTP_HOST=smtp.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-login
# SMTP_PASSWORD=your-smtp-key
# SMTP_TLS=true
# SMTP_SSL=false

# The "From" address staff will see.  Many providers require it to match the
# SMTP account, otherwise the mail is rejected or lands in spam.
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Payroll System
