# ---------------------------------------------------------------------------
# HRMS / payroll - example configuration
#
# Copy this file to ".env" (next to the project root) and fill in real values.
# A real environment variable always wins over a value in ".env", so a stale
# file can never override your deployment's settings.
#
# The app runs fine with none of this set (development defaults + test-mode
# payments), so only uncomment/set what you actually need.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=Payroll System
APP_ENV=production
# Public base URL. REQUIRED for real payments and clickable email links.
# Must be the exact public origin, no trailing slash. Used to build payment
# success/cancel/return URLs and callbacks.
APP_BASE_URL=https://payroll.example.com
# Secret used to sign sessions. Generate a long random value in production.
APP_SECRET_KEY=change-me-to-a-long-random-string
SESSION_MAX_AGE=604800
# Mark the session cookie Secure (HTTPS only). Leave false for local http://
# development; set true in production.
SESSION_HTTPS_ONLY=false

# ---------------------------------------------------------------------------
# Platform administrator
# ---------------------------------------------------------------------------
# Comma-separated list of the ONLY email addresses allowed to open the admin
# panel (/admin).  Every other account is refused, even one whose role was
# changed to platform_admin by mistake, and the "Admin panel" link is hidden
# from its sidebar.
# Leave it empty to allow every account holding the platform_admin role.
# PLATFORM_ADMIN_EMAILS=owner@example.com

# ---------------------------------------------------------------------------
# Database (defaults to ./hrms.db when empty)
# ---------------------------------------------------------------------------
# SQLite (default) - zero setup, single file, fine for development.
# DATABASE_URL=sqlite:///./hrms.db
#
# MySQL / MariaDB (the server bundled with XAMPP). Requires the "pymysql"
# driver:  pip install pymysql
# DATABASE_URL=mysql+pymysql://payroll:payroll@127.0.0.1:3306/payroll?charset=utf8mb4
#
# PostgreSQL:  pip install psycopg2-binary
# DATABASE_URL=postgresql+psycopg2://payroll:payroll@127.0.0.1:5432/payroll

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
# UPLOAD_DIR=
MAX_LOGO_MB=2

# Employee documents are private: stored outside static/ by default and only
# served through an authenticated download route.
# DOCUMENTS_DIR=
MAX_DOCUMENT_MB=10

# ---------------------------------------------------------------------------
# Mail
#   console (default) -> messages are written to ./outbox, nothing is sent.
#   smtp              -> requires SMTP_HOST (see below).
#
# In console mode the app tells you the invitation email was NOT sent and
# where the message was written instead.  Switch to smtp for real delivery.
# Note: APP_BASE_URL above must be publicly reachable, otherwise the links
# inside the emails point at localhost and cannot be opened by the recipient.
# ---------------------------------------------------------------------------
MAIL_DRIVER=console
# MAIL_DRIVER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS=true
# SMTP_SSL=false
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Payroll System

# ---------------------------------------------------------------------------
# Invitations / password resets
# ---------------------------------------------------------------------------
INVITATION_TTL_HOURS=72
RESET_TTL_HOURS=2

# ---------------------------------------------------------------------------
# Subscription plans
# ---------------------------------------------------------------------------
TRIAL_DAYS=7
SUBSCRIPTION_MONTHLY_USD=10
SUBSCRIPTION_ANNUAL_USD=90
SUBSCRIPTION_NOTICE_DAYS=3

# ===========================================================================
# Payments
#
# Credentials can be supplied here (recommended for production), OR saved at
# runtime from the in-app "Settings -> Payment gateway" screen by a platform
# administrator. A value saved there is encrypted at rest and takes precedence
# over the environment; anything left unset falls back to these variables.
#
# Leave PAYMENTS_ENABLED=false to explore the flow with the built-in test mode
# (no real money, no credentials needed). Setting it to true disables test mode
# and requires the credentials below to accept real payments.
#
# Only a provider whose credentials are present is selectable in the UI.
# Webhook secrets/IDs are NOT part of that check, but ARE required for a
# payment to activate reliably - configure them too.
# ---------------------------------------------------------------------------
PAYMENTS_ENABLED=false
PAYMENT_SANDBOX=true

# --- Visa / Mastercard (Stripe Checkout) -----------------------------------
# Dashboard: Developers -> API keys / Webhooks.
# Webhook endpoint to add:  POST {APP_BASE_URL}/webhooks/visa
# Events: checkout.session.completed, payment_intent.payment_failed,
#         checkout.session.expired, charge.refunded, charge.refund.updated
# Use sk_test_... / whsec_... while testing, sk_live_... when live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# PayPal (Orders v2)
#   PAYPAL_MODE=sandbox (default) or live.
#   Dashboard: Developer -> Apps & Credentials, then add a webhook.
# ---------------------------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# Webhook endpoint: https://<your-domain>/webhooks/paypal
# Subscribe to: PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.DENIED,
#   PAYMENT.CAPTURE.FAILED, PAYMENT.CAPTURE.REFUNDED,
#   CHECKOUT.ORDER.APPROVED, CHECKOUT.ORDER.CANCELLED
PAYPAL_WEBHOOK_ID=

# ---------------------------------------------------------------------------
# M-Pesa (Safaricom Daraja, STK push)
#   MPESA_ENV=sandbox (default) or production.
#   Callbacks are not signed; MPESA_CALLBACK_URL must be public HTTPS.
#   Falls back to APP_BASE_URL + /webhooks/mpesa when left blank.
# ---------------------------------------------------------------------------
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
# KES per USD used to convert USD plan prices for M-Pesa.
MPESA_USD_RATE=130
